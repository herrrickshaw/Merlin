opam-version: "2.0"
name: "merlin"
version: "0.2.0"
synopsis: "Advanced LFS Data Analyzer with Financial Analysis"
description: "Compact OCaml tool for stock screening, LFS analysis, and financial data processing with advanced statistical and portfolio analysis"
maintainer: "herrrickshaw"
authors: ["herrrickshaw"]
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0"}
  "yojson"
  "ppx_deriving_yojson"
  "ppx_deriving"
  "ppx_sexp_conv"
  "sexplib"
  "core" {>= "v0.14"}
  "containers" {>= "3.0"}
  "csv"
  "sqlite3"
  "zarith"
  "logs"
  "fmt"
  "re"
  "angstrom"
  "unix"
]
